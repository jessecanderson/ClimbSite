{
  "name": "climbsite",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.cjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "import:ridb:campgrounds": "tsx scripts/import-ridb-campgrounds.ts",
    "import:ridb:climbing-areas": "tsx scripts/import-ridb-climbing-areas.ts",
    "import:nps:campgrounds": "tsx scripts/import-nps-campgrounds.ts",
    "import:openbeta:climbing-areas": "tsx scripts/import-openbeta-climbing-areas.ts",
    "sync:ridb": "pnpm import:ridb:climbing-areas -- --state KY --limit 25 --max-pages 1 --activities 7,100041,100040,100035 && pnpm import:ridb:campgrounds -- --state KY --query campground --limit 25 --max-pages 1",
    "prebuild": "node scripts/check-runtime.cjs",
    "test:db": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "^7.10.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "next": "^16.4.3",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
