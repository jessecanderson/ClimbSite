generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ImportEntityType {
  CAMPGROUND
  CLIMBING_AREA
}

enum ImportRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum ImportCandidateStatus {
  PENDING
  ACCEPTED
  LINKED
  IGNORED
  NEEDS_RESEARCH
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String?         @unique
  emailVerified DateTime?
  image         String?
  role          Role            @default(USER)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  accounts      Account[]
  sessions      Session[]
  authenticators Authenticator[]
  trips         Trip[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model DestinationHub {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  region      String
  summary     String
  seasonNotes String?
  lat         Float
  lng         Float
  sourceName  String?
  sourceUrl   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  areas       HubClimbingArea[]
  campgrounds HubCampground[]
}

model DataSource {
  id          String              @id @default(cuid())
  key         String              @unique
  name        String
  baseUrl     String?
  docsUrl     String?
  termsUrl    String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  importRuns  ImportRun[]
  candidates  ImportCandidate[]
  references  ExternalReference[]
}

model ImportRun {
  id              String          @id @default(cuid())
  sourceId        String
  entityType      ImportEntityType
  status          ImportRunStatus @default(RUNNING)
  params          Json
  startedAt       DateTime        @default(now())
  finishedAt      DateTime?
  fetchedCount    Int             @default(0)
  candidateCount  Int             @default(0)
  skippedCount    Int             @default(0)
  error           String?
  source          DataSource      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  candidates      ImportCandidate[]

  @@index([sourceId])
  @@index([entityType])
  @@index([status])
}

model ImportCandidate {
  id                 String                @id @default(cuid())
  sourceId           String
  importRunId        String?
  entityType         ImportEntityType
  externalId         String
  name               String
  normalizedName     String
  region             String?
  sourceUrl          String?
  lat                Float?
  lng                Float?
  rawPayload         Json
  mappedPayload      Json
  status             ImportCandidateStatus @default(PENDING)
  matchedCampgroundId String?
  matchedAreaId      String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  source             DataSource            @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  importRun          ImportRun?            @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  matchedCampground  Campground?           @relation("CampgroundImportCandidates", fields: [matchedCampgroundId], references: [id])
  matchedArea        ClimbingArea?         @relation("ClimbingAreaImportCandidates", fields: [matchedAreaId], references: [id])

  @@unique([sourceId, entityType, externalId])
  @@index([importRunId])
  @@index([entityType])
  @@index([status])
  @@index([matchedCampgroundId])
  @@index([matchedAreaId])
}

model ExternalReference {
  id             String           @id @default(cuid())
  sourceId       String
  entityType     ImportEntityType
  externalId     String
  sourceUrl      String?
  campgroundId   String?
  climbingAreaId String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  source         DataSource       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  campground     Campground?      @relation(fields: [campgroundId], references: [id], onDelete: Cascade)
  climbingArea   ClimbingArea?    @relation(fields: [climbingAreaId], references: [id], onDelete: Cascade)

  @@unique([sourceId, entityType, externalId])
  @@index([campgroundId])
  @@index([climbingAreaId])
}

model ClimbingArea {
  id              String               @id @default(cuid())
  slug            String               @unique
  name            String
  region          String
  summary         String
  bestFor         String
  approach        String
  approachMinutes Int?
  parking         String
  roadDifficulty  String
  lat             Float
  lng             Float
  sourceType      String               @default("curated")
  reviewStatus    String               @default("reviewed")
  lastReviewedAt  DateTime?
  sourceName      String?
  sourceUrl       String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  hubLinks        HubClimbingArea[]
  campgroundLinks AreaCampgroundLink[]
  tripStops       TripStop[]
  importCandidates ImportCandidate[]      @relation("ClimbingAreaImportCandidates")
  externalReferences ExternalReference[]
}

model Campground {
  id              String               @id @default(cuid())
  slug            String               @unique
  name            String
  type            String
  summary         String
  amenities       String
  campingFit      String
  reservationUrl  String?
  sourceName      String?
  sourceUrl       String?
  lat             Float
  lng             Float
  sourceType      String               @default("curated")
  reviewStatus    String               @default("reviewed")
  lastReviewedAt  DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  hubLinks        HubCampground[]
  areaLinks       AreaCampgroundLink[]
  selectedStops   TripStop[]           @relation("SelectedCampground")
  importCandidates ImportCandidate[]    @relation("CampgroundImportCandidates")
  externalReferences ExternalReference[]
}

model AreaCampgroundLink {
  id             String       @id @default(cuid())
  climbingAreaId String
  campgroundId   String
  miles          Float
  driveMinutes   Int
  logisticsNote  String
  rank           Int          @default(0)
  sourceType     String       @default("curated")
  reviewStatus   String       @default("reviewed")
  lastReviewedAt DateTime?
  climbingArea   ClimbingArea @relation(fields: [climbingAreaId], references: [id], onDelete: Cascade)
  campground     Campground   @relation(fields: [campgroundId], references: [id], onDelete: Cascade)

  @@unique([climbingAreaId, campgroundId])
  @@index([campgroundId])
}

model HubClimbingArea {
  hubId          String
  climbingAreaId String
  rank           Int    @default(0)
  hub            DestinationHub @relation(fields: [hubId], references: [id], onDelete: Cascade)
  climbingArea   ClimbingArea   @relation(fields: [climbingAreaId], references: [id], onDelete: Cascade)

  @@id([hubId, climbingAreaId])
  @@index([climbingAreaId])
}

model HubCampground {
  hubId        String
  campgroundId String
  rank         Int    @default(0)
  hub          DestinationHub @relation(fields: [hubId], references: [id], onDelete: Cascade)
  campground   Campground     @relation(fields: [campgroundId], references: [id], onDelete: Cascade)

  @@id([hubId, campgroundId])
  @@index([campgroundId])
}

model Trip {
  id        String     @id @default(cuid())
  name      String
  notes     String?
  startDate DateTime?  @db.Date
  endDate   DateTime?  @db.Date
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  stops     TripStop[]

  @@index([userId])
}

model TripStop {
  id             String       @id @default(cuid())
  tripId         String
  climbingAreaId String
  selectedCampgroundId String?
  order          Int
  notes          String?
  plannedDate    DateTime?    @db.Date
  createdAt      DateTime     @default(now())
  trip           Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  climbingArea   ClimbingArea @relation(fields: [climbingAreaId], references: [id])
  selectedCampground Campground? @relation("SelectedCampground", fields: [selectedCampgroundId], references: [id])

  @@index([tripId])
  @@index([climbingAreaId])
  @@index([selectedCampgroundId])
}
